<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
	Reglas de estilo del servicio: siguen las convenciones que ya usa el código (tabulaciones al estilo de Spring,
	imports explícitos, sin Lombok). Cualquier violación hace fallar el build (./gradlew checkstyleMain checkstyleTest).
-->
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="severity" value="error"/>
	<property name="fileExtensions" value="java"/>
	<property name="tabWidth" value="4"/>

	<!-- Archivos -->
	<module name="NewlineAtEndOfFile"/>
	<!-- La indentación es con tabulaciones. Se permiten las continuaciones de Javadoc (" * ...") y la alineación
		 con espacios después de las tabulaciones, por ejemplo dentro de los text blocks de SQL y JSON -->
	<module name="RegexpSingleline">
		<property name="format" value="^ +[^*\s]"/>
		<property name="message" value="Indentación con espacios; use tabulaciones"/>
	</module>
	<module name="RegexpSingleline">
		<property name="format" value="\s+$"/>
		<property name="message" value="Espacios al final de la línea"/>
	</module>
	<module name="LineLength">
		<property name="max" value="120"/>
		<!-- Se ignoran los imports y las líneas que solo contienen un literal de texto (mensajes, SQL) -->
		<property name="ignorePattern" value="^(package|import) .*$|^\s*&quot;[^&quot;]*&quot;[,);]*$"/>
	</module>

	<module name="SuppressWarningsFilter"/>

	<module name="TreeWalker">
		<module name="SuppressWarningsHolder"/>

		<!-- Imports -->
		<module name="AvoidStarImport"/>
		<module name="RedundantImport"/>
		<module name="UnusedImports"/>
		<module name="IllegalImport">
			<property name="illegalPkgs" value="sun, lombok"/>
		</module>

		<!-- Nombres -->
		<module name="PackageName">
			<property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
		</module>
		<module name="TypeName"/>
		<!-- Las pruebas usan snake_case descriptivo (should_reject_with_409_...) -->
		<module name="MethodName">
			<property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
		</module>
		<module name="MemberName"/>
		<module name="ParameterName"/>
		<module name="LocalVariableName"/>
		<!-- Se admite el nombre convencional de los loggers -->
		<module name="ConstantName">
			<property name="format" value="^(log|logger)$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
		</module>
		<module name="StaticVariableName"/>
		<module name="RecordComponentName"/>

		<!-- Bloques y declaraciones -->
		<module name="NeedBraces"/>
		<module name="LeftCurly"/>
		<!-- Estilo Spring: "}" sola en su línea antes de else, catch y finally -->
		<module name="RightCurly">
			<property name="option" value="alone"/>
			<property name="tokens" value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE"/>
		</module>
		<module name="RightCurly">
			<property name="option" value="alone_or_singleline"/>
			<property name="tokens" value="CLASS_DEF, METHOD_DEF, CTOR_DEF, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT,
					INSTANCE_INIT, RECORD_DEF, COMPACT_CTOR_DEF, ENUM_DEF, INTERFACE_DEF"/>
		</module>
		<module name="EmptyStatement"/>
		<module name="OneStatementPerLine"/>
		<module name="MultipleVariableDeclarations"/>
		<module name="ModifierOrder"/>
		<module name="UpperEll"/>
		<module name="ArrayTypeStyle"/>

		<!-- Errores comunes -->
		<module name="EqualsHashCode"/>
		<module name="SimplifyBooleanExpression"/>
		<module name="SimplifyBooleanReturn"/>
		<module name="StringLiteralEquality"/>
		<module name="MissingSwitchDefault"/>
		<module name="FallThrough"/>
		<module name="EmptyCatchBlock"/>
		<module name="CovariantEquals"/>

		<!-- Espacios -->
		<module name="WhitespaceAround">
			<property name="allowEmptyConstructors" value="true"/>
			<property name="allowEmptyMethods" value="true"/>
			<property name="allowEmptyTypes" value="true"/>
			<property name="allowEmptyLoops" value="true"/>
			<property name="allowEmptyLambdas" value="true"/>
		</module>
		<module name="WhitespaceAfter"/>
		<module name="NoWhitespaceBefore"/>
		<module name="GenericWhitespace"/>
		<module name="MethodParamPad"/>
		<module name="ParenPad"/>
	</module>
</module>
