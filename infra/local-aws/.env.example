# =====================================================================
# Emulador local de AWS (Moto): variables de infra/local-aws/docker-compose.yml
# Copie este archivo como infra/local-aws/.env. Nunca ponga aquí credenciales reales.
# =====================================================================

# Puerto de esta máquina por el que se publica el emulador (MESSAGING_ENDPOINT del servicio apunta aquí)
LOCAL_AWS_HOST_PORT=4566

# Región con que se crean los recursos. Debe coincidir con AWS_REGION del .env del servicio. Use la región
# seleccionada de su proyecto (AWS Settings > View all projects > Overview > Additional Info > Region)
AWS_REGION=us-east-2

# Credenciales ficticias: el emulador acepta cualquier valor
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Visibility timeout de las colas, en segundos: tiempo que un mensaje recibido queda oculto antes de volver a la
# cola si no se borra. Tras 3 recepciones pasa a la DLQ (HU-DOC-10, criterio 6)
SQS_VISIBILITY_TIMEOUT_SECONDS=30
