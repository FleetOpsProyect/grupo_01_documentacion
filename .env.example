# =====================================================================
# fleetops-document-service: variables de entorno
# Copie este archivo como .env y reemplace los valores de ejemplo.
# Nunca suba el archivo .env al repositorio.
# =====================================================================

# --- Servidor HTTP ---
# Puerto interno en el que escucha la aplicación
SERVER_PORT=8081
# Puerto del host que docker compose publica hacia SERVER_PORT
SERVICE_HOST_PORT=8081

# --- Base de datos PostgreSQL (base propia del servicio, DAS sec. 5) ---
# Host de la base de datos al ejecutar sin Docker (en docker compose se usa el servicio documents-db)
DB_HOST=localhost
# Puerto de la base de datos al ejecutar sin Docker
DB_PORT=5432
# Puerto de esta máquina por el que docker compose publica la base para revisarla con un cliente
# (DBeaver, pgAdmin, psql). Distinto de 5432 para no chocar con un PostgreSQL local
DB_HOST_PORT=5434
# Dirección en la que se publica ese puerto. Por defecto 127.0.0.1 (solo esta máquina). Use 0.0.0.0 únicamente
# en un servidor, para aceptar conexiones desde cualquier origen, y limite el origen en el firewall
DB_BIND_ADDRESS=127.0.0.1
# Nombre de la base de datos
DB_NAME=fleetops_documents
# Usuario de la base de datos
DB_USER=documents_app
# Contraseña de la base de datos (use una contraseña segura propia)
DB_PASSWORD=change_me_db_password
# Tiempo máximo para obtener una conexión, en ms; garantiza 503 en menos de 2 s si cae la BD (DAS sec. 10)
DB_CONNECTION_TIMEOUT_MS=1500
# Tiempo máximo para validar una conexión, en ms (debe ser menor que DB_CONNECTION_TIMEOUT_MS)
DB_VALIDATION_TIMEOUT_MS=1000

# --- Reglas de negocio ---
# Zona horaria de negocio (Colombia, UTC-05:00): define la «fecha actual» (ADR-DOC-13) y el desfase con que
# salen las marcas de tiempo de la API, los eventos y las sesiones de la base de datos (DAS sec. 7)
BUSINESS_TIME_ZONE=America/Bogota
# Umbrales de alerta de vencimiento en días, separados por comas (HU-DOC-06, ADR-DOC-09)
ALERT_THRESHOLD_DAYS=30,15,7,1

# --- Observabilidad ---
# Nivel de log raíz: TRACE, DEBUG, INFO, WARN o ERROR. El @timestamp de los logs va en UTC (decisión P-08)
LOG_LEVEL=INFO

# --- Mensajería AWS SNS + SQS (HU-DOC-10) ---
# Perfil de Spring: local (emulador Moto de infra/local-aws), aws (AWS real en EC2) o vacío (sin mensajería)
SPRING_PROFILES_ACTIVE=local
# Región de AWS. En AWS real, la región seleccionada del proyecto (AWS Settings > View all projects > Overview >
# Additional Info > Region). Con el emulador, la misma de infra/local-aws/.env
AWS_REGION=us-east-2
# Solo perfil local: URL del emulador al ejecutar con bootRun (puerto LOCAL_AWS_HOST_PORT de infra/local-aws/.env)
MESSAGING_ENDPOINT=http://localhost:4566
# Solo perfil local: URL del emulador vista desde el contenedor del servicio (docker compose)
MESSAGING_CONTAINER_ENDPOINT=http://host.docker.internal:4566
# Solo perfil local: credenciales FICTICIAS que el emulador acepta. En AWS real se dejan vacías: el servicio usa
# el rol de la instancia EC2. Nunca ponga aquí claves reales
MESSAGING_ACCESS_KEY_ID=test
MESSAGING_SECRET_ACCESS_KEY=test
# Long polling de SQS, de 0 a 20 segundos (recomendado 20)
MESSAGING_WAIT_TIME_SECONDS=20
# Mensajes por lectura, de 1 a 10
MESSAGING_MAX_MESSAGES=10
# Espera antes de reintentar si SQS no responde (HU-DOC-10, criterio 7)
MESSAGING_RETRY_DELAY=5s

# --- JVM (solo en contenedor) ---
# Opciones de la JVM. Su zona por defecto queda en UTC: el servicio aplica BUSINESS_TIME_ZONE de forma explícita
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -Duser.timezone=UTC
